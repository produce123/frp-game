# frp-game 自建服构建配置（不是上游原版；改这里要重新 pnpm build:web）
# 地图解密 key 来自官方 Web 产物（官方站公开的 16 位 key）；只用于解官方公开 .mmmap。
VITE_WEB_BASE_PATH=/games/monopoly/
MONOPOLY_DOMAIN=localhost
PROTOCOL=http
API_BASE_PREFIX=/monopoly-server
ICE_BASE_PREFIX=
ADMIN_BASE_PREFIX=
SERVER_PORT=7891
ICE_SERVER_PORT=7891
MONOPOLY_ADMIN_PORT=7891
MAP_ENCRYPT_KEY=rO8yZ3bM2bW9gA9u
NODE_ENV=production