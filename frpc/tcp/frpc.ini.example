; SakuraFrp frpc 配置模板 —— TCP 通道（脱敏）
;
; ⚠️ 真正在跑的配置**不是这个文件**：SakuraFrp 启动器启动时自己生成一份喂给 frpc.exe。
;    改隧道请去**面板 / 启动器**（隧道 → 编辑），在这里改不会生效。见 ../README.md
;
; 硬约束：本机服务端只监听 127.0.0.1:7891（tools/service.mjs 的 PORT），
;         所以 local_port 必须是 7891；改一边必须同时改另一边。
;
; ⚠️ 国内节点会**拦截明文 HTTP**（回它自己的 501 合规页，字节根本不到本机）。
;    现在在用的那条路是在**面板里开「自动 HTTPS」**：TLS 由 frpc 收下，
;    脱壳之后仍然是明文 HTTP 发给 7891（所以服务端代码一行都不用改）。
;    手工模式对应的 frpc 选项见官方用户手册的 feature-auto-https 一节 ——
;    **我们没用手工模式，所以那个选项名没实测过，别照抄**；面板才是在用的那条路。
;    怎么发现、怎么验证的：../../docs/TUNNEL.md 坑五。
;
; 排障与验证：../../docs/TUNNEL.md

[common]
user = <你的 SakuraFrp 访问密钥>

sakura_mode = true
login_fail_exit = false

; 节点地址以**面板 / 启动器实际连的**为准（我们这条现在走 <节点域名>）
server_addr = <节点域名>
server_port = <节点控制端口，以面板 / 启动器为准>

; 隧道名必须和面板里那条一致。
; ⚠️ **别复用历史上用过的名字**：节点上会残留旧代理，症状是面板显示"在线"、
;    frpc 日志写着"启动成功"，但访客一直拿到 501/503（../../docs/TUNNEL.md 坑二）。
;    现在面板里那条叫 TCP。
[TCP]
# id = <隧道 ID>
type = tcp
local_ip = 127.0.0.1
local_port = 7891
remote_port = <公网端口>

; 隧道如果设了密码才需要这一行；面板里没设就删掉
; auth_pass = <隧道密码>